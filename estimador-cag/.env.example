# OpenAI API Key
OPENAI_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# LLM Provider (openai | anthropic)
LLM_PROVIDER=

# LLM Model (gpt-4o-mini | claude-3-5-sonnet-20240620)
LLM_MODEL=

# App Environment (development | production)
APP_ENV=

# Log Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=

# Streamlit UI — base URL of the Estimator API (no API key needed here)
ESTIMATOR_API_URL=http://localhost:8000

# Streamlit UI — HTTP timeout for estimate requests (seconds)
ESTIMATOR_REQUEST_TIMEOUT_SECONDS=120

# LiteLLM wrapper: try PRIMARY_MODEL first, then FALLBACK_MODEL.
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT=30
LLM_RETRIES=2

# Redis exact-match cache. docker compose overrides this to redis://redis:6379.
# Use redis://localhost:6379 when uvicorn runs on the host.
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400

# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:8501
